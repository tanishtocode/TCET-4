# Supabase → Project Settings → API (both values are public-safe; never use the service_role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# City appended to address searches when geocoding
VITE_DEFAULT_CITY=Mumbai
# GEMINI_API_KEY is a Supabase Edge Function secret, NOT a frontend variable.
